PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
JWT_SECRET=dev-only-secret-change-this
JWT_EXPIRES_IN=7d
MYSQL_URL=mysql://root:root@localhost:3306/flowstate_dev
FLOWSTATE_DM_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
FLOWSTATE_UPLOADS_DIR=./uploads

# Security hardening
ALLOWED_ORIGINS=
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
PUBLIC_RATE_LIMIT_WINDOW_MS=900000
PUBLIC_RATE_LIMIT_MAX=20
HEALTH_RATE_LIMIT_WINDOW_MS=60000
HEALTH_RATE_LIMIT_MAX=120
AUDIT_LOG_RETENTION_DAYS=90
