PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
JWT_SECRET=dev-only-secret-change-this
JWT_EXPIRES_IN=7d
# Comma-separated user UUIDs allowed to create workspaces.
PLATFORM_OWNER_USER_IDS=
# Generate with: bun -e 'import bcrypt from "bcryptjs"; console.log(await bcrypt.hash("your-password", 12))'
WORKSPACE_CREATION_PASSWORD_HASH=
DEFAULT_WORKSPACE_JOIN_CODE_HASH=
MYSQL_URL=mysql://root:root@localhost:3306/flowstate_dev
FLOWSTATE_DM_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
FLOWSTATE_UPLOADS_DIR=./uploads

# Reliability, rollback, and backups
OPS_ALERT_EMAIL_TO=
OPS_ALERT_EMAIL_FROM=
BACKUP_LOCAL_DIR=./backups
BACKUP_ENCRYPTION_ENABLED=false
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY_ID=primary
BACKUP_VERIFY_SCRATCH_MYSQL_URL=
BACKUP_R2_BUCKET=
BACKUP_R2_PREFIX=flowstate
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_ENDPOINT=
BACKUP_RETENTION_LOCAL_PREDEPLOY=5
BACKUP_RETENTION_LOCAL_DAILY=7
BACKUP_RETENTION_LOCAL_WEEKLY=4
BACKUP_RETENTION_REMOTE_PREDEPLOY=10
BACKUP_RETENTION_REMOTE_DAILY=14
BACKUP_RETENTION_REMOTE_WEEKLY=8
MYSQL_CONTAINER_NAME=flowstate-mysql
MYSQL_ENV_FILE=./deploy/vps/mysql.env
DB_SLOW_QUERY_THRESHOLD_MS=750

# Security hardening
ALLOWED_ORIGINS=
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
PUBLIC_RATE_LIMIT_WINDOW_MS=900000
PUBLIC_RATE_LIMIT_MAX=20
HEALTH_RATE_LIMIT_WINDOW_MS=60000
HEALTH_RATE_LIMIT_MAX=120
AUDIT_LOG_RETENTION_DAYS=90


