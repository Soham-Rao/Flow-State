NODE_ENV=production
PORT=4000
CLIENT_ORIGIN=https://flo-state.in
PUBLIC_APP_URL=https://flo-state.in
MYSQL_URL=mysql://flowstate:change-me@127.0.0.1:3306/flowstate_prod
JWT_SECRET=change-me-with-a-long-random-secret
JWT_EXPIRES_IN=7d
WORKSPACE_CREATION_PASSWORD_HASH=replace-with-a-bcrypt-hash
DEFAULT_WORKSPACE_JOIN_CODE_HASH=replace-with-a-different-bcrypt-hash
FLOWSTATE_DM_ENCRYPTION_KEY=replace-with-a-32-byte-key-as-64-hex-or-44-base64
FLOWSTATE_UPLOADS_DIR=/var/lib/flowstate/uploads

# Reliability, rollback, and backups
OPS_ALERT_EMAIL_TO=
OPS_ALERT_EMAIL_FROM=
BACKUP_LOCAL_DIR=/var/lib/flowstate/backups
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_ENCRYPTION_KEY=replace-with-a-32-byte-key-as-64-hex-or-44-base64
BACKUP_ENCRYPTION_KEY_ID=primary
BACKUP_VERIFY_SCRATCH_MYSQL_URL=mysql://flowstate:change-me@127.0.0.1:3306/flowstate_restore_verify
BACKUP_R2_BUCKET=
BACKUP_R2_PREFIX=flowstate
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_ENDPOINT=
BACKUP_RETENTION_LOCAL_PREDEPLOY=5
BACKUP_RETENTION_LOCAL_DAILY=7
BACKUP_RETENTION_LOCAL_WEEKLY=4
BACKUP_RETENTION_REMOTE_PREDEPLOY=10
BACKUP_RETENTION_REMOTE_DAILY=14
BACKUP_RETENTION_REMOTE_WEEKLY=8
MYSQL_CONTAINER_NAME=flowstate-mysql
MYSQL_ENV_FILE=/opt/flowstate/infra/mysql.env
DB_SLOW_QUERY_THRESHOLD_MS=750

# Security hardening
ALLOWED_ORIGINS=
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=5
REGISTRATION_HONEYPOT_ENABLED=true
PUBLIC_RATE_LIMIT_WINDOW_MS=900000
PUBLIC_RATE_LIMIT_MAX=20
HEALTH_RATE_LIMIT_WINDOW_MS=60000
HEALTH_RATE_LIMIT_MAX=120
AUDIT_LOG_RETENTION_DAYS=90

# Keep disabled for the first deploy, then report, then delete after verification.
UNASSIGNED_ACCOUNT_CLEANUP_MODE=disabled
UNASSIGNED_ACCOUNT_RETENTION_HOURS=48
UNASSIGNED_ACCOUNT_CLEANUP_BATCH_SIZE=25
UNASSIGNED_ACCOUNT_REQUIRE_RECENT_BACKUP=true
UNASSIGNED_ACCOUNT_MAX_BACKUP_AGE_HOURS=26
UNASSIGNED_ACCOUNT_PROTECTED_EMAILS=demo@example.com,owner@example.com
UNASSIGNED_ACCOUNT_PROTECTED_USER_IDS=

# Optional SMTP settings
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=flowstate
# SMTP_PASS=change-me
# SMTP_FROM=FlowState <no-reply@flo-state.in>
# SMTP_SECURE=false


